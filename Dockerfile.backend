FROM php:8.5-fpm

# System dependencies needed for common Laravel extensions
RUN apt-get update && apt-get install -y \
    git \
    curl \
    unzip \
    libpq-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    zip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
    pdo \
    pdo_pgsql \
    pgsql \
    mbstring \
    exif \
    pcntl \
    bcmath \
    gd \
    zip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Composer from its official image so we always get the latest stable
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/laravel

# Copy composer files first to leverage Docker layer caching —
# dependencies are only re-installed when composer.json or composer.lock changes
COPY backend/composer.json backend/composer.lock ./

RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist

# Copy the rest of the application source
COPY backend/ .

# Generate the optimised autoloader now that all source files are present
RUN composer dump-autoload --optimize

# Set correct ownership so PHP-FPM can read/write storage and cache
RUN chown -R www-data:www-data /var/www/laravel/storage /var/www/laravel/bootstrap/cache

EXPOSE 9000

CMD ["php-fpm"]


# ── App ───────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
# Generate with: docker compose exec backend php artisan key:generate --show
APP_KEY=

# ── Database ──────────────────────────────────────────────
DB_DATABASE=helpdesk
DB_USERNAME=postgres
DB_PASSWORD=secret

# ── Next.js ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
